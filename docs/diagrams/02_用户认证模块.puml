@startuml
start
:用户访问;
if (选择登录方式) then (密码登录)
  :输入账号/密码;
  :服务端验证;
  if (验证通过?) then (是)
    :签发 JWT Token;
  else (否)
    :返回错误提示;
    :重新输入;
  endif
elseif (验证码登录) then
  :输入手机号;
  :点击获取验证码;
  if (60s 冷却通过?) then (是)
    :生成4位随机码;
    if (启用真实短信?) then (是)
      :通过容联云发送短信;
    else (否)
      :Mock模式-返回验证码到前端;
    endif
    :存入 Redis 5分钟有效;
    :用户输入验证码;
    if (Redis 比对匹配?) then (是)
      :签发 JWT Token;
    else (否)
      :验证码错误;
      :重新输入;
    endif
  else (否)
    :提示"请60秒后再试";
  endif
else (注册账号)
  :填写用户名/手机/邮箱/密码;
  :获取验证码;
  :提交注册;
  if (手机或邮箱已注册?) then (是)
    :返回 409 冲突;
  else (否)
    :创建用户;
    :自动登录;
  endif
endif
:Redis 记录 Token;
:返回 access_token;
:前端存入 localStorage;
:跳转首页;
stop
@enduml
