@startuml
start
:登录管理员账号;
:查看系统仪表盘;
:总用户数/课程数/订单数;
:待审核事项汇总;

partition "用户管理" {
  :用户列表;
  :查看用户详情;
  :启用/封禁用户;
  :删除用户(硬删除);
}

partition "审核管理" {
  if (审核类型?) then (课程审核)
    :查看待审核课程详情;
    if (通过?) then (是)
      :课程上架;
    else (否)
      :拒绝并返回原因;
    endif
  else (讲师审核)
    :查看讲师申请;
    if (通过?) then (是)
      :开通讲师权限;
    else (否)
      :拒绝申请;
    endif
  else (秒杀审核)
    :查看秒杀活动;
    if (通过?) then (是)
      :活动生效;
    else (否)
      :拒绝活动;
    endif
  endif
}

partition "订单管理" {
  :订单列表;
  :按状态筛选;
  :查看订单详情;
  :退款处理;
}
stop
@enduml
