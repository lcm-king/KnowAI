# ============================================
# 知学AI - 生产环境配置模板
# 复制此文件为 .env.docker 并填入真实值
# ============================================
#
# ⚠️ 安全清单 - 上线前务必完成：
#   1. 所有密码/密钥使用随机生成的强值（建议 openssl rand -hex 32）
#   2. JWT_SECRET_KEY 至少 32 字符
#   3. MYSQL_ROOT_PASSWORD / MYSQL_PASSWORD / RABBITMQ_DEFAULT_PASS 不能用默认值
#   4. PAY_MOCK 和 SMS_MOCK 在生产环境必须设为 false
#   5. ALLOWED_ORIGINS 改成你真实的前端域名
#   6. ALIPAY_PRIVATE_KEY / ALIPAY_PUBLIC_KEY 用真实支付宝商户密钥
#   7. CLOOPEN_* 用真实容联云通讯账号
#   8. OPENAI_API_KEY / EMBEDDING_API_KEY 用真实 LLM 服务商 key

# App
APP_ENV=production
DEBUG=false
API_PREFIX=/api
# 上传文件存储目录（容器内路径，对应 docker-compose 的 uploads_data 卷）
UPLOAD_DIR=/app/uploads

# MySQL
MYSQL_ROOT_PASSWORD=please-change-to-strong-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=knowai
MYSQL_PASSWORD=please-change-to-strong-db-password
MYSQL_DATABASE=knowai

# MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=knowai

# Redis
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# RabbitMQ
RABBITMQ_DEFAULT_USER=knowai
RABBITMQ_DEFAULT_PASS=please-change-to-strong-rabbitmq-password

# JWT - 至少 32 字符随机字符串，建议：openssl rand -hex 32
JWT_SECRET_KEY=please-change-this-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - 改成你的真实域名（多个用逗号分隔的 JSON 数组格式）
ALLOWED_ORIGINS=["http://localhost", "http://127.0.0.1", "https://your-domain.com"]

# Order
ORDER_EXPIRE_MINUTES=30

# Payment - 生产环境填入真实密钥，PAY_MOCK 必须为 false
WEIXIN_APPID=
WEIXIN_MCHID=
WEIXIN_KEY=
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
NOTIFY_URL=https://your-domain.com/api/pay/notify/alipay
PAY_MOCK=true
ALIPAY_SANDBOX=true

# Dify (备选 AI 后端)
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# AI / LLM - 主配置
# 国内可使用 SiliconFlow: OPENAI_BASE_URL=https://api.siliconflow.cn/v1, LLM_MODEL=Qwen/Qwen3-8B
# 国内可使用 SiliconFlow: EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1, EMBEDDING_MODEL=BAAI/bge-m3
# OpenAI 官方: OPENAI_BASE_URL 留空, LLM_MODEL=gpt-4o-mini, EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
VECTOR_DB_PATH=/app/chroma_db

# 容联云通讯 SMS - 生产环境必填，SMS_MOCK 必须为 false
CLOOPEN_ACCOUNT_SID=
CLOOPEN_AUTH_TOKEN=
CLOOPEN_APP_ID=
CLOOPEN_TEMPLATE_ID=1
# 容联 REST 接口地址，一般不需要改
CLOOPEN_REST_URL=https://app.cloopen.com:8883
SMS_MOCK=true
