# ============================================
# 知学AI - 生产环境配置模板
# 复制此文件为 .env.docker 并填入真实值
# ============================================

# App
APP_ENV=production
DEBUG=false
API_PREFIX=/api

# MySQL
MYSQL_ROOT_PASSWORD=your-strong-root-password
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=knowai
MYSQL_PASSWORD=your-strong-db-password
MYSQL_DATABASE=knowai

# MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=knowai

# Redis
REDIS_URL=redis://redis:6379/0

# Elasticsearch
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# RabbitMQ
RABBITMQ_DEFAULT_USER=knowai
RABBITMQ_DEFAULT_PASS=your-strong-rabbitmq-password

# JWT
JWT_SECRET_KEY=your-long-random-jwt-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS — 改成你的域名
ALLOWED_ORIGINS=["http://localhost", "http://你的域名.com"]

# Order
ORDER_EXPIRE_MINUTES=30

# Payment — 生产环境填入真实密钥
WEIXIN_APPID=
WEIXIN_MCHID=
WEIXIN_KEY=
ALIPAY_APPID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
NOTIFY_URL=https://你的域名.com/api/pay/notify/alipay
PAY_MOCK=true
ALIPAY_SANDBOX=true

# Dify
DIFY_API_URL=https://api.dify.ai/v1
DIFY_API_KEY=

# AI / LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
VECTOR_DB_PATH=/app/chroma_db

# 容联云通讯 SMS
CLOOPEN_ACCOUNT_SID=
CLOOPEN_AUTH_TOKEN=
CLOOPEN_APP_ID=
CLOOPEN_TEMPLATE_ID=1
SMS_MOCK=true
